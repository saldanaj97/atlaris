{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-push.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for git push or --no-verify"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/require-pr-quiz.sh\"",
            "timeout": 30,
            "statusMessage": "Checking for a quiz pass before gh pr create or merge"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/require-evidence.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for the evidence report"
          }
        ]
      }
    ]
  }
}
