# Vercel Preview environment variable names (values intentionally blank).

# Application
APP_URL=

# Authentication and billing (Clerk)
CLERK_BILLING_RECONCILIATION_ENABLED=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# AI (OpenRouter)
OPENROUTER_API_KEY=
# Optional per-tier keys for grounded generation; each falls back to OPENROUTER_API_KEY.
OPENROUTER_API_KEY_FREE=
OPENROUTER_API_KEY_STARTER=
OPENROUTER_API_KEY_PRO=
# Required OpenRouter preset slugs; the system prompts live only in these presets.
OPENROUTER_PLAN_PRESET=
OPENROUTER_LESSON_PRESET=
# Optional Cloudflare AI Gateway: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/openrouter
# plus its authentication token. Unset sends requests straight to OpenRouter.
OPENROUTER_BASE_URL=
CF_AI_GATEWAY_TOKEN=

# Database (Supabase-managed PostgreSQL)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Email and scheduled delivery (Resend)
EMAIL_UNSUBSCRIBE_TOKEN_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Operations and maintenance
MAINTENANCE_WORKER_TOKEN=
RETENTION_CLEANUP_ENABLED=

# Background jobs Worker (Cloudflare)
JOBS_SIGNING_SECRET=
JOBS_WORKER_URL=

# Feature flags (Cloudflare Flagship; token needs the Flagship Evaluate permission)
FLAGSHIP_APP_ID=
FLAGSHIP_ACCOUNT_ID=
FLAGSHIP_API_TOKEN=
