{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["import", "react", "jsx-a11y", "nextjs", "vitest"],
  "jsPlugins": ["@shadcn/lint"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "env": {
    "browser": true,
    "builtin": true,
    "node": true
  },
  "settings": {
    "next": {
      "rootDir": "."
    }
  },
  "rules": {
    "eslint/no-await-in-loop": "off",
    "eslint/no-constant-binary-expression": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "eslint/no-shadow": "off",
    "import/namespace": "off",
    "import/no-named-as-default": "off",
    "import/no-unassigned-import": "off",
    "jest/no-conditional-expect": "off",
    "jest/no-standalone-expect": "off",
    "jest/require-to-throw-message": "off",
    "jest/valid-expect": "off",
    "nextjs/no-assign-module-variable": "off",
    "oxc/no-map-spread": "off",
    "react/react-in-jsx-scope": "off",
    "shadcn/no-raw-colors": [
      "error",
      {
        "allow": ["fill-mode-both"]
      }
    ],
    "shadcn/no-unknown-classes": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error",
    // Intentionally deferred until the design-system rollout:
    // "shadcn/no-restyle": "off",
    // "shadcn/no-arbitrary-values": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectTypeOf",
          "assert",
          "assertType",
          "expect*"
        ]
      }
    ],
    "vitest/no-conditional-expect": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/valid-expect": "off"
  },
  "ignorePatterns": [
    ".next/**",
    ".test-dist/**",
    "coverage/**",
    "node_modules/**",
    "next-env.d.ts"
  ],
  "overrides": [
    {
      "files": [
        "src/app/**/*.{ts,tsx}",
        "src/lib/api/**/*.{ts,tsx}",
        "src/lib/integrations/**/*.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@supabase/service-role",
                "message": "Use request-scoped getDb()/requestBoundary in request-layer code; keep service-role imports in feature-owned server boundaries, workers, tests, or Supabase helpers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/**/*.{ts,tsx}"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["tests/unit/utils/utils.spec.ts"],
      "rules": {
        "shadcn/no-raw-colors": "off",
        "shadcn/no-unknown-classes": "off"
      }
    },
    // UI implementations forward class props and compose variants internally.
    {
      "files": ["src/components/ui/**/*.{ts,tsx}"],
      "rules": {
        "shadcn/require-static-classes": "off"
      }
    }
  ]
}
