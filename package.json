    "oxlint-tsgolint": "7.0.2001",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,mjs,cts,mts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
