    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "flags": "^4.3.0",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.433.6",
    "posthog-node": "^5.52.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "2.15.4",
    "resend": "6.28.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "workflow": "^4.8.0",
    "zod": "^4.6.5"
