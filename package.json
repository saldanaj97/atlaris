{
  "name": "atlaris",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "next build --turbopack",
    "dev": "bash scripts/dev/start.sh",
    "deploy:preview": "vercel deploy --yes",
    "start": "next start",
    "check": "concurrently --kill-others-on-fail --names lint,type --prefix-colors blue,magenta \"pnpm lint\" \"pnpm typecheck\"",
    "lint": "oxlint src tests scripts supabase workers --max-warnings=0",
    "typecheck": "tsc --noEmit && pnpm check:type:workers",
    "check:type:workers": "tsc -p workers/jobs --noEmit && tsc -p tests/unit/workers --noEmit",
    "db": "tsx scripts/db/cli.ts",
    "workers": "tsx scripts/workers/cli.ts",
    "secrets:sync": "tsx scripts/secrets/sync.ts",
    "test": "tsx scripts/tests/cli.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@clerk/nextjs": "7.9.14",
    "@flags-sdk/vercel": "^1.4.6",
    "@openrouter/sdk": "^0.13.67",
    "@radix-ui/react-accordion": "^1.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-hover-card": "^1.2.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@sentry/cloudflare": "10.76.2",
    "@sentry/nextjs": "^10.76.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "flags": "^4.3.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.438.7",
    "posthog-node": "^5.55.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "2.15.4",
    "resend": "6.32.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@circleci/vitest-circleci-coverage": "^0.3.707",
    "@clerk/testing": "^2.2.45",
    "@google/design.md": "^0.4.0",
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "0.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "16.4.0",
    "oxc-parser": "^0.153.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,mjs,cts,mts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
