{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/notifications/email?runKind=daily",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/notifications/email?runKind=weekly",
      "schedule": "30 14 * * 1"
    }
  ]
}
