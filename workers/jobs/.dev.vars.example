# Copy to workers/jobs/.dev.vars for `pnpm workers dev` (gitignored).
# Names only; never commit values. Secrets are declared with bindings.secret()
# in cloudflare.config.ts; deployed Workers get them from the dashboard (B1).
# In the deployed modes (staging/production) the job switches below are Worker
# secrets too; locally they come from this file.

# Direct plan research (DEV-171): the switch and the Parallel Search key.
# PARALLEL_DIRECT_RESEARCH=false
# PARALLEL_API_KEY=

# Job switches:
# JOBS_PAUSED=false
