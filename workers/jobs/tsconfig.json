{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "esnext"
    ],
    "types": [
      "./.cloudflare/types/index.d.ts",
      "node"
    ],
    "plugins": [],
    "incremental": false,
    "rootDir": "../..",
